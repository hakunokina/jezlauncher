<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <app.olauncher.ui.WatchingScrollView
        android:id="@+id/widgetsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <app.olauncher.ui.WidgetWallView
            android:id="@+id/widgetsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" />

    </app.olauncher.ui.WatchingScrollView>

    <TextView
        android:id="@+id/widgetsAdd"
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="24dp"
        android:paddingVertical="@dimen/app_padding_vertical"
        android:text="@string/widgets_add"
        android:textColor="@android:color/white" />

    <LinearLayout
        android:id="@+id/widgetsEditBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widgetsRemove"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/widgets_remove"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/widgetsDone"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/widgets_done"
            android:textColor="@android:color/white" />

    </LinearLayout>

</FrameLayout>
