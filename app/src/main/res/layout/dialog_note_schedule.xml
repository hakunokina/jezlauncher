<?xml version="1.0" encoding="utf-8"?>
<!-- Schedule menu of a note: kind, days (weekly), date (once) and time, alert type, lead time.
     Choices are plain texts; the picked one is opaque (see NoteScheduleDialog.render) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scheduleOnce"
            style="@style/ScheduleChoice"
            android:text="@string/note_schedule_once" />

        <TextView
            android:id="@+id/scheduleDaily"
            style="@style/ScheduleChoice"
            android:text="@string/note_schedule_daily" />

        <TextView
            android:id="@+id/scheduleWeekly"
            style="@style/ScheduleChoice"
            android:text="@string/note_schedule_weekly" />
    </LinearLayout>

    <!-- Seven day toggles, added in code in the locale's week order -->
    <LinearLayout
        android:id="@+id/scheduleDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scheduleDate"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="12dp"
            android:visibility="gone"
            tools:text="12 Oct"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/scheduleTime"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:padding="12dp"
            tools:text="09:00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scheduleNotification"
            style="@style/ScheduleChoice"
            android:text="@string/note_alert_notification" />

        <TextView
            android:id="@+id/scheduleFullScreen"
            style="@style/ScheduleChoice"
            android:text="@string/note_alert_full_screen" />

        <TextView
            android:id="@+id/scheduleAlarm"
            style="@style/ScheduleChoice"
            android:text="@string/note_alert_alarm" />
    </LinearLayout>

    <!-- What the picked alert type does -->
    <TextView
        android:id="@+id/scheduleAlertHint"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:gravity="center"
        tools:text="@string/note_alert_notification_hint" />

    <TextView
        android:id="@+id/scheduleLead"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="12dp"
        tools:text="30 min before" />

</LinearLayout>
