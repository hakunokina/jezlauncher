<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="0.1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notesRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/notesEmpty"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="24dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/notes_empty"
            android:textColor="?attr/primaryColorTrans50"
            android:visibility="gone" />

        <!-- Shows while a note is dragged; dropping the note here opens its schedule menu -->
        <FrameLayout
            android:id="@+id/notesRoutineZone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:visibility="gone">

            <TextView
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/note_schedule"
                app:drawableStartCompat="@drawable/ic_alarm"
                app:drawableTint="?attr/primaryColor" />
        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/noteInput"
            style="@style/TextLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/notes_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:textColorHint="?attr/primaryColorTrans50" />

        <ImageButton
            android:id="@+id/noteSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notes_send"
            android:src="@drawable/ic_send" />

    </LinearLayout>

</LinearLayout>
